TELEGRAM_TOKEN=123456:your-bot-token
# Telegram user IDs allowed to use staff analytics (comma separated)
ADMIN_IDS=
# Telegram chat (group or user) id where hand-offs to managers are posted
MANAGER_CHAT_ID=

ONEC_BASE_URL=http://your-1c-host/YourBase
ONEC_USER=
ONEC_PASSWORD=

OLLAMA_URL=http://127.0.0.1:11434
LLM_MODEL=qwen2.5:7b
# reply languages the model handles well (add tg,uz with a stronger model)
REPLY_LANGUAGES=ru,en,zh
# answered via the local translator model (Ollama), MT_NUM_GPU=0 runs it on CPU
TRANSLATE_LANGUAGES=tg,uz
MT_MODEL=translategemma:4b
MT_NUM_GPU=0
# true = reply in Tajik/Uzbek (machine translation), false = understand them but reply in Russian
TRANSLATE_REPLIES=false

TTS_ENABLED=true
TTS_ENGINE=silero
TTS_SPEAKER_RU=ru_ekaterina
TTS_DEVICE=cuda
TTS_VOICE_REF=
STT_ENABLED=true
STT_MODEL=small
STT_DEVICE=cpu
